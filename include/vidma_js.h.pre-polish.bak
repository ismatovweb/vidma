// Auto-generated by patch_client_livekit.py — LiveKit SDK edition
#ifndef VIDMA_JS_H
#define VIDMA_JS_H

constexpr const char* VIDMA_JS = R"js(
// =====================================================================
// Vidma client — LiveKit SDK edition (Sprint 2)
// =====================================================================
'use strict';

const { Room, RoomEvent, Track, ConnectionState, DisconnectReason } = LivekitClient;

let room = null;
let currentRoomId = null;
let currentName = null;
let currentSessionId = null;   // server-issued identity
let selectedRating = 0;

// map: participantIdentity -> { wrapperEl, videoEl, stream }
const remotePanels = new Map();

// ---------------------------------------------------------------------
// util
// ---------------------------------------------------------------------
function showToast(text) {
    const t = document.getElementById('toast');
    if (!t) return;
    t.textContent = text;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2000);
}

function setSecurityBar(visible) {
    const b = document.getElementById('security-bar');
    if (b) b.style.display = visible ? 'flex' : 'none';
}

function setLocalVideoLabel(txt) {
    const el = document.getElementById('local-video-label');
    if (el) el.textContent = txt;
}

// ---------------------------------------------------------------------
// room creation / joining
// ---------------------------------------------------------------------
async function createRoom() {
    let name = (document.getElementById('create-name')?.value || '').trim() || 'Гость';
    try {
        const res = await fetch('/api/room/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
        });
        const data = await res.json();
        if (!data.success) { showToast('Не удалось создать комнату'); return; }
        currentRoomId = data.roomId;
        currentName = name;
        document.getElementById('created-room-id').textContent = data.roomId;
        document.getElementById('room-created').style.display = 'block';
    } catch (e) {
        showToast('Ошибка соединения');
        console.error(e);
    }
}

function copyRoomLink() {
    if (!currentRoomId) return;
    const link = location.origin + '/?room=' + currentRoomId;
    const text = link + '\nVidma — Видеовстречи в один клик';
    navigator.clipboard.writeText(text).then(() => showToast('Ссылка скопирована'));
}

function joinCreatedRoom() {
    if (currentRoomId && currentName) joinRoomById(currentRoomId, currentName);
}

async function joinRoom() {
    let name = (document.getElementById('join-name')?.value || '').trim() || 'Гость';
    let raw = (document.getElementById('room-id')?.value || '').trim();
    const digits = raw.replace(/\D/g, '');
    if (digits.length !== 9) { alert('Введите 9 цифр кода комнаты'); return; }
    const roomId = digits.slice(0,3) + '-' + digits.slice(3,6) + '-' + digits.slice(6,9);
    try {
        const res = await fetch('/api/room/' + roomId + '/exists');
        const data = await res.json();
        if (!data.exists) { alert('Комната не найдена'); return; }
        joinRoomById(roomId, name);
    } catch (e) { alert('Ошибка соединения'); }
}

async function joinRoomById(roomId, name) {
    currentRoomId = roomId;
    currentName = name;

    // Show call screen early, so user sees feedback
    document.getElementById('main-screen').style.display = 'none';
    document.getElementById('call-screen').style.display = 'block';
    document.getElementById('current-room-code').textContent = roomId;
    setLocalVideoLabel(name + ' (Вы)');

    // 1. Get token from server
    let data;
    try {
        const res = await fetch('/api/room/' + roomId + '/token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
        });
        data = await res.json();
        if (!data.livekitUrl || !data.livekitToken) {
            throw new Error('Server did not return livekit config');
        }
    } catch (e) {
        alert('Не удалось получить токен: ' + e.message);
        leaveCall();
        return;
    }
    currentSessionId = data.identity;

    // 2. Create room
    room = new Room({
        adaptiveStream: true,
        dynacast: true,
        videoCaptureDefaults: {
            resolution: { width: 1280, height: 720, frameRate: 30 }
        },
        audioCaptureDefaults: {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true
        }
    });

    // 3. Event handlers
    room
        .on(RoomEvent.Connected, onConnected)
        .on(RoomEvent.Disconnected, onDisconnected)
        .on(RoomEvent.ParticipantConnected, onParticipantConnected)
        .on(RoomEvent.ParticipantDisconnected, onParticipantDisconnected)
        .on(RoomEvent.TrackSubscribed, onTrackSubscribed)
        .on(RoomEvent.TrackUnsubscribed, onTrackUnsubscribed)
        .on(RoomEvent.LocalTrackPublished, onLocalTrackPublished)
        .on(RoomEvent.DataReceived, onDataReceived);

    // 4. Connect FIRST
    try {
        await room.connect(data.livekitUrl, data.livekitToken);
    } catch (e) {
        alert('Не удалось подключиться к комнате: ' + e.message);
        leaveCall();
        return;
    }

    // 5. THEN publish camera + mic
    try {
        await room.localParticipant.enableCameraAndMicrophone();
    } catch (e) {
        console.warn('Camera/mic unavailable:', e);
        const modal = document.getElementById('camera-choice-modal');
        if (modal) modal.classList.add('active');
    }

    setSecurityBar(true);

    // 6. Attach local video
    const camPub = room.localParticipant.getTrackPublication(Track.Source.Camera);
    if (camPub && camPub.videoTrack) {
        camPub.videoTrack.attach(document.getElementById('local-video'));
    }

    // 7. Attach already-present remote participants
    room.remoteParticipants.forEach(p => attachParticipant(p));
}

// ---------------------------------------------------------------------
// room event handlers
// ---------------------------------------------------------------------
function onConnected() {
    console.log('LiveKit: connected as', room.localParticipant.identity);
}

function onDisconnected(reason) {
    console.log('LiveKit: disconnected, reason =', reason);
    leaveCallUI();
    if (reason === DisconnectReason.CLIENT_INITIATED) {
        showRatingModal();
    } else {
        showToast('Соединение с комнатой потеряно');
    }
}

function onParticipantConnected(participant) {
    console.log('Participant joined:', participant.identity);
    attachParticipant(participant);
}

function onParticipantDisconnected(participant) {
    console.log('Participant left:', participant.identity);
    detachParticipant(participant.identity);
}

function onTrackSubscribed(track, publication, participant) {
    console.log('Track subscribed:', participant.identity, track.kind, publication.source);
    attachParticipant(participant);
}

function onTrackUnsubscribed(track, publication, participant) {
    console.log('Track unsubscribed:', participant.identity, track.kind);
    // If video track removed, panel may be empty. Keep it, update if needed.
    const panel = remotePanels.get(participant.identity);
    if (panel && track.kind === 'video' && publication.source === Track.Source.Camera) {
        if (panel.videoEl) panel.videoEl.srcObject = null;
    }
}

function onLocalTrackPublished(publication) {
    if (publication.source === Track.Source.Camera && publication.videoTrack) {
        publication.videoTrack.attach(document.getElementById('local-video'));
    }
}

function onDataReceived(payload, participant, kind, topic) {
    console.log('[chat] DataReceived:', {
        payloadSize: payload ? payload.byteLength : 0,
        from: participant ? participant.identity : '(self)',
        kind, topic
    });
    try {
        const text = new TextDecoder().decode(payload);
        console.log('[chat] decoded:', text);
        const msg = JSON.parse(text);
        if (msg.type === 'chat') {
            appendChatMessage(participant ? participant.identity : 'unknown', msg.text);
        } else {
            console.warn('[chat] not a chat message:', msg);
        }
    } catch (e) { console.warn('Bad datachannel payload:', e); }
}

// ---------------------------------------------------------------------
// video panel management
// ---------------------------------------------------------------------
function attachParticipant(participant) {
    const id = participant.identity;
    const label = participant.name || id.slice(0, 6);

    let panel = remotePanels.get(id);
    if (!panel) {
        const wrapper = document.createElement('div');
        wrapper.id = 'remote-' + id;
        wrapper.className = 'remote-video-wrapper';

        const video = document.createElement('video');
        video.autoplay = true;
        video.playsInline = true;

        const lbl = document.createElement('div');
        lbl.className = 'video-label';
        lbl.textContent = label;

        wrapper.appendChild(video);
        wrapper.appendChild(lbl);
        document.getElementById('remote-videos-grid').appendChild(wrapper);

        panel = { wrapperEl: wrapper, videoEl: video, labelEl: lbl, stream: new MediaStream() };
        remotePanels.set(id, panel);
    }

    // Attach all currently subscribed tracks
    participant.trackPublications.forEach(pub => {
        if (pub.isSubscribed && pub.track && pub.kind === 'video' && pub.source === Track.Source.Camera) {
            pub.track.attach(panel.videoEl);
        }
        if (pub.isSubscribed && pub.track && pub.kind === 'audio') {
            pub.track.attach(panel.videoEl);
        }
    });
}

function detachParticipant(identity) {
    const panel = remotePanels.get(identity);
    if (!panel) return;
    try {
        panel.videoEl.srcObject = null;
        panel.wrapperEl.remove();
    } catch (e) {}
    remotePanels.delete(identity);
}

// ---------------------------------------------------------------------
// controls
// ---------------------------------------------------------------------
async function toggleMic() {
    if (!room) return;
    const enabled = room.localParticipant.isMicrophoneEnabled;
    try {
        await room.localParticipant.setMicrophoneEnabled(!enabled);
        const micOn = document.getElementById('mic-icon-on');
        const micOff = document.getElementById('mic-icon-off');
        if (micOn && micOff) {
            micOn.style.display = enabled ? 'none' : '';
            micOff.style.display = enabled ? '' : 'none';
        }
    } catch (e) { console.warn(e); }
}

async function toggleCam() {
    if (!room) return;
    const enabled = room.localParticipant.isCameraEnabled;
    try {
        await room.localParticipant.setCameraEnabled(!enabled);
        const camOn = document.getElementById('cam-icon-on');
        const camOff = document.getElementById('cam-icon-off');
        if (camOn && camOff) {
            camOn.style.display = enabled ? 'none' : '';
            camOff.style.display = enabled ? '' : 'none';
        }
    } catch (e) { console.warn(e); }
}

async function toggleScreenShare() {
    if (!room) return;
    const btn = document.getElementById('toggle-screen');
    const currently = room.localParticipant.isScreenShareEnabled;
    try {
        await room.localParticipant.setScreenShareEnabled(!currently);
        if (btn) btn.classList.toggle('active', !currently);
    } catch (e) {
        console.warn('Screen share failed:', e);
    }
}

function leaveCall() {
    if (room) {
        try { room.disconnect(); } catch (e) {}
        room = null;
    }
    leaveCallUI();
    showRatingModal();
}

function leaveCallUI() {
    // stop local preview
    const localVideo = document.getElementById('local-video');
    if (localVideo) localVideo.srcObject = null;

    // remove all remote panels
    remotePanels.forEach(p => { try { p.wrapperEl.remove(); } catch (e) {} });
    remotePanels.clear();

    setSecurityBar(false);
    document.getElementById('call-screen').style.display = 'none';
    document.getElementById('main-screen').style.display = 'block';
}


// =====================================================================
// Sprint 3 — Chat via LiveKit DataChannel (E2EE, no server storage)
// =====================================================================
const CHAT_TOPIC = 'vidma-chat';
let chatOpen = false;
let chatUnread = 0;
const chatHistory = new Map(); // roomId -> [{sender, text, ts, mine}]

function chatStorageKey(roomId) { return 'vidma-chat-' + roomId; }

function loadChatHistory(roomId) {
    if (!roomId) return [];
    if (chatHistory.has(roomId)) return chatHistory.get(roomId);
    try {
        const raw = localStorage.getItem(chatStorageKey(roomId));
        const arr = raw ? JSON.parse(raw) : [];
        chatHistory.set(roomId, arr);
        return arr;
    } catch (e) {
        chatHistory.set(roomId, []);
        return [];
    }
}

function saveChatHistory(roomId, msgs) {
    if (!roomId) return;
    chatHistory.set(roomId, msgs);
    try { localStorage.setItem(chatStorageKey(roomId), JSON.stringify(msgs)); }
    catch (e) { console.warn('chat save failed', e); }
}

function renderChatMessage(msg) {
    const box = document.getElementById('chat-messages');
    if (!box) return;
    const empty = document.getElementById('chat-empty');
    if (empty) empty.remove();

    const el = document.createElement('div');
    el.className = 'chat-msg ' + (msg.system ? 'system' : (msg.mine ? 'mine' : 'theirs'));
    if (!msg.system) {
        const a = document.createElement('span');
        a.className = 'chat-author';
        a.textContent = msg.mine ? 'Вы' : (msg.sender || 'Участник');
        el.appendChild(a);
    }
    el.appendChild(document.createTextNode(msg.text));
    box.appendChild(el);
    box.scrollTop = box.scrollHeight;
}

function renderChatHistory(roomId) {
    const box = document.getElementById('chat-messages');
    if (!box) return;
    box.innerHTML = '';
    const msgs = loadChatHistory(roomId);
    if (msgs.length === 0) {
        const e = document.createElement('div');
        e.id = 'chat-empty';
        e.textContent = 'История чата видна только вам и хранится в этом браузере.';
        box.appendChild(e);
        return;
    }
    msgs.forEach(renderChatMessage);
}

function appendChatMessage(from, text) {
    // from === currentSessionId → mine; else theirs
    const isMine = (from === currentSessionId);
    const msg = {
        sender: isMine ? null : (room?.remoteParticipants?.get?.(from)?.name || from),
        text: String(text).slice(0, 500),
        ts: Date.now(),
        mine: isMine
    };
    const arr = loadChatHistory(currentRoomId);
    arr.push(msg);
    if (arr.length > 500) arr.splice(0, arr.length - 500);
    saveChatHistory(currentRoomId, arr);

    renderChatMessage(msg);

    if (!chatOpen && !isMine) {
        chatUnread++;
        updateChatBadge();
        showToast('Новое сообщение в чате');
    }
}

function updateChatBadge() {
    const badge = document.getElementById('chat-badge');
    const btn = document.getElementById('toggle-chat');
    if (!badge || !btn) return;
    if (chatUnread > 0) {
        badge.textContent = chatUnread > 99 ? '99+' : String(chatUnread);
        btn.classList.add('has-unread');
    } else {
        badge.textContent = '0';
        btn.classList.remove('has-unread');
    }
}

function toggleChatPanel() {
    chatOpen = !chatOpen;
    const panel = document.getElementById('chat-panel');
    if (panel) panel.classList.toggle('open', chatOpen);
    if (chatOpen) {
        chatUnread = 0;
        updateChatBadge();
        renderChatHistory(currentRoomId);
        setTimeout(() => document.getElementById('chat-input')?.focus(), 50);
    }
}

function handleChatSubmit(ev) {
    ev.preventDefault();
    const input = document.getElementById('chat-input');
    if (!input) return;
    const text = input.value.trim();
    if (!text) return;
    sendChatMessage(text).then(() => {
        input.value = '';
    }).catch(e => {
        console.warn('send failed', e);
        showToast('Не удалось отправить сообщение');
    });
}

async function sendChatMessage(text) {
    if (!room || !text) { console.warn('[chat] sendChatMessage: no room or text'); return; }
    if (!room.localParticipant || !room.localParticipant.publishData) {
        console.warn('[chat] publishData not available'); return;
    }
    const payload = new TextEncoder().encode(JSON.stringify({
        type: 'chat', text: String(text).slice(0, 500)
    }));
    console.log('[chat] publishData: size=', payload.byteLength, 'topic=', CHAT_TOPIC);
    try {
        await room.localParticipant.publishData(payload, {
            reliable: true,
            topic: CHAT_TOPIC
        });
        console.log('[chat] publishData: OK');
    } catch (e) {
        console.error('[chat] publishData FAILED:', e);
        showToast('Не удалось отправить');
        throw e;
    }
    appendChatMessage(currentSessionId, text);
}

function showRatingModal() {
    const modal = document.getElementById('rating-modal');
    if (!modal) return;
    modal.classList.add('active');
    const stars = document.querySelectorAll('#stars span');
    stars.forEach(star => {
        star.onclick = () => {
            selectedRating = parseInt(star.dataset.value, 10);
            stars.forEach(s => s.classList.remove('active'));
            for (let i = 0; i < selectedRating; i++) stars[i].classList.add('active');
        };
    });
}

function closeRating() {
    const modal = document.getElementById('rating-modal');
    if (modal) modal.classList.remove('active');
    selectedRating = 0;
    const stars = document.querySelectorAll('#stars span');
    stars.forEach(s => s.classList.remove('active'));
}

function submitRating() {
    if (selectedRating > 0) {
        fetch('/api/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roomId: currentRoomId, rating: selectedRating, comment: '' })
        }).catch(() => {});
    }
    closeRating();
}

// ---------------------------------------------------------------------
// camera-permission retry from modal
// ---------------------------------------------------------------------
async function retryCamera() {
    const modal = document.getElementById('camera-choice-modal');
    if (modal) modal.classList.remove('active');
    if (!room) return;
    try {
        await room.localParticipant.enableCameraAndMicrophone();
    } catch (e) {
        if (modal) modal.classList.add('active');
    }
}

async function joinWithoutCamera() {
    const modal = document.getElementById('camera-choice-modal');
    if (modal) modal.classList.remove('active');
    if (!room) return;
    try {
        await room.localParticipant.setMicrophoneEnabled(true);
        await room.localParticipant.setCameraEnabled(false);
    } catch (e) { console.warn(e); }
}

// ---------------------------------------------------------------------
// URL ?room= auto-fill
// ---------------------------------------------------------------------
document.addEventListener('DOMContentLoaded', () => {
    const inp = document.getElementById('room-id');
    if (!inp) return;

    inp.addEventListener('input', (e) => {
        const itype = e.inputType || '';
        if (itype.startsWith('delete')) return;
        const digits = e.target.value.replace(/\D/g, '').slice(0, 9);
        let fmt = digits;
        if (digits.length >= 7)      fmt = digits.slice(0,3)+'-'+digits.slice(3,6)+'-'+digits.slice(6);
        else if (digits.length === 6) fmt = digits.slice(0,3)+'-'+digits.slice(3,6)+'-';
        else if (digits.length >= 4) fmt = digits.slice(0,3)+'-'+digits.slice(3);
        else if (digits.length === 3) fmt = digits+'-';
        e.target.value = fmt;
        e.target.setSelectionRange(fmt.length, fmt.length);
    });

    const urlRoom = new URLSearchParams(location.search).get('room');
    if (urlRoom) {
        const digits = urlRoom.replace(/\D/g, '').slice(0, 9);
        let fmt = digits;
        if (digits.length >= 7)      fmt = digits.slice(0,3)+'-'+digits.slice(3,6)+'-'+digits.slice(6);
        else if (digits.length === 6) fmt = digits.slice(0,3)+'-'+digits.slice(3,6)+'-';
        else if (digits.length >= 4) fmt = digits.slice(0,3)+'-'+digits.slice(3);
        else if (digits.length === 3) fmt = digits+'-';
        inp.value = fmt;
    }
});

// expose to inline onclick handlers in HTML
window.createRoom = createRoom;
window.copyRoomLink = copyRoomLink;
window.joinCreatedRoom = joinCreatedRoom;
window.joinRoom = joinRoom;
window.toggleMic = toggleMic;
window.toggleCam = toggleCam;
window.toggleScreenShare = toggleScreenShare;
window.leaveCall = leaveCall;
window.submitRating = submitRating;
window.closeRating = closeRating;
window.retryCamera = retryCamera;
window.joinWithoutCamera = joinWithoutCamera;
window.shareRoomFromCall = copyRoomLink;
window.toggleChatPanel = toggleChatPanel;
window.handleChatSubmit = handleChatSubmit;
)js";

#endif // VIDMA_JS_H
