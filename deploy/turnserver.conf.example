# coturn configuration for Vidma
# Copy to /etc/turnserver.conf and replace external-ip and static-auth-secret

listening-ip=0.0.0.0
external-ip=REPLACE_WITH_YOUR_PUBLIC_IP
listening-port=3478

# REST auth (same secret as /etc/vidma.env TURN_SECRET)
use-auth-secret
static-auth-secret=REPLACE_WITH_LONG_RANDOM_STRING

realm=vidma.online

min-port=49152
max-port=65535

fingerprint
no-cli
no-loopback-peers
no-multicast-peers
stale-nonce=600
total-quota=100
bps-capacity=0
